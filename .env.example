# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="K-Drama Compass API"
APP_VERSION="1.0.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=kdrama-compass-dev-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kdrama

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CALLS=60
RATE_LIMIT_PERIOD=60

# ── Nested settings (pydantic-settings __ delimiter) ─────────────────────────
# Paths
PATHS__DATA_RAW=data/raw
PATHS__DATA_PROCESSED=data/processed
PATHS__MODELS_ARTIFACTS=models/artifacts
PATHS__MODELS_REGISTRY=models/registry
PATHS__LOGS=logs

# Model
MODEL__TOP_K=10
MODEL__CONTENT_WEIGHT=0.5
MODEL__COLLAB_WEIGHT=0.5
